# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor: nunca exponer al cliente
SUPABASE_SECRET_KEY=

# Correos (agradecimiento de /sumate y envíos masivos del panel)
# Proveedor: "smtp", "brevo" o "resend". Si queda vacío, se usa el que esté configurado.
EMAIL_PROVIDER=smtp
# SMTP de una casilla del dominio (Hostinger: smtp.hostinger.com, puerto 465). Solo servidor.
# SMTP_USER es la casilla completa y EMAIL_FROM tiene que usar esa misma dirección.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Brevo → SMTP y API → Claves API. Solo servidor.
BREVO_API_KEY=
# Resend (alternativa) → API Keys. Solo servidor.
RESEND_API_KEY=
# Remitente: en Brevo tiene que estar verificado (Remitentes). Con el dominio propio: hola@mujeresxmas.com
EMAIL_FROM="Mujeres x Más <hola@mujeresxmas.com>"
# Casilla del equipo que recibe los avisos (registro en /sumate y pedidos de empresas). Vacía = sin avisos.
ADMIN_NOTIFY_EMAIL=

# URL pública del sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Modo del sitio. Vacío = "solo registro": el público solo ve /sumate y las administradoras entran
# por /admin (con la sesión iniciada ven todo). Para abrir el sitio completo: SITE_MODE=abierto
SITE_MODE=

# Muestra los cursos, notas, voces y eventos de ejemplo de la home fuera de desarrollo.
# Solo para versiones de prueba: en producción, dejarla vacía.
SHOW_SAMPLE_CONTENT=

# Kiero (API de partners: alta y baja de la tienda incluida en el plan Crecer)
# La clave se configura en el PartnerProgram del admin de Kiero. Solo servidor.
# Modo prueba por defecto: el sitio simula las respuestas y no llama a Kiero.
# Para usar la API real: KIERO_MODE=live y la clave cargada.
KIERO_MODE=
KIERO_API_KEY=
# Opcional: otra URL base de la API (por defecto https://dashboard.kiero.tech)
KIERO_API_URL=
# Opcional: link para aceptar la invitación, con {token} donde va el token que devuelve Kiero
KIERO_INVITE_URL=
